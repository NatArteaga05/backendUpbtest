{
  "info": {
    "name": "backendUpb - Productos",
    "description": "CRUD de productos (Express + PostgreSQL) desplegado en Render.\n\nCambia la variable `baseUrl` para usar local o producción.\n\nLas solicitudes de crear, actualizar y eliminar modifican datos reales. Ejecuta Crear producto antes de consultar, actualizar o eliminar: guarda automáticamente su id en la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://backendupbtest-zgc9.onrender.com", "description": "Producción (Render)" },
    { "key": "localUrl", "value": "http://localhost:3000", "description": "Local: copia este valor en baseUrl para probar en tu PC" },
    { "key": "id", "value": "", "description": "Se completa al ejecutar Crear producto; también puedes indicar un id existente" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/productos", "host": ["{{baseUrl}}"], "path": ["api", "productos"] }
      }
    },
    {
      "name": "Buscar productos por nombre",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos?nombre=prueba",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"],
          "query": [{ "key": "nombre", "value": "prueba", "description": "Texto parcial a buscar (no distingue mayúsculas). Sin coincidencias devuelve []." }]
        }
      }
    },
    {
      "name": "Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Laptop\",\n    \"precio\": 1500,\n    \"stock\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/productos", "host": ["{{baseUrl}}"], "path": ["api", "productos"] }
      }
    },
    {
      "name": "Obtener producto por id",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/productos/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{id}}"] }
      }
    },
    {
      "name": "Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": 1350,\n    \"stock\": 10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/productos/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{id}}"] }
      }
    },
    {
      "name": "Eliminar producto",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/api/productos/{{id}}", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{id}}"] }
      }
    },
    {
      "name": "Crear producto inválido (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": -10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/productos", "host": ["{{baseUrl}}"], "path": ["api", "productos"] }
      }
    }
  ]
}
